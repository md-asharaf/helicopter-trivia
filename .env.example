# Helicopter Trivia — Environment Variables

# REQUIRED: Your quiz API endpoint URL
# The game will fetch quiz data from this URL on load.
# Response must be QuizQuestion[] or { questions: QuizQuestion[] }
# Each question: { prompt, hint, options (4 items), answer }
VITE_QUIZ_API_URL=

# OPTIONAL: Enable debug overlay (never visible in production)
# Shows FPS, game phase, question session ID, bomb state, etc.
VITE_GAME_DEBUG=false
